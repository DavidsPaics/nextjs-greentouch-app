# Copy this file to .env and fill in the values: cp .env.example .env
# .env is not committed to git. Never put real secrets in this file.

# --- Required -------------------------------------------------------------

# Random secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the application (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# Other origins allowed to use the login API, comma-separated, no spaces.
# The origin of BETTER_AUTH_URL is always trusted. Wildcards like https://*.rsu.lv work.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://greentouch.rsu.lv

# Database connection. Only needed when running without Docker (e.g. npm run dev);
# docker compose sets it automatically from the POSTGRES_* values below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/greentouch

# --- Database (docker compose) --------------------------------------------
# Avoid @ : / in the password, it is used inside the database URL.

POSTGRES_USER=greentouch
POSTGRES_PASSWORD=greentouch
POSTGRES_DB=greentouch

# --- Admin account --------------------------------------------------------
# Created on start if ADMIN_EMAIL and ADMIN_PASSWORD are set and the account
# doesn't exist yet. Changing these later does not change an existing account.

ADMIN_EMAIL=example@example.com
ADMIN_PASSWORD=CHANGE_ME_001
ADMIN_NAME=GreenTouch Admin

# --- Email (password reset links) -----------------------------------------
# If SMTP_HOST is empty, emails are not sent and their content (including
# the reset link) is printed to the server log instead.
#
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true,
#         SMTP_USER=resend, SMTP_PASSWORD=<API key>
# Gmail:  SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#         SMTP_USER=<gmail address>, SMTP_PASSWORD=<app password>

SMTP_HOST=
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GreenTouch <noreply@example.com>"

# --- Other ----------------------------------------------------------------

# Time zone used for dates shown by the server
TZ=Europe/Riga
